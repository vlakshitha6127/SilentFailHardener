# Nebius AI Cloud / OpenAI Compatible Token Factory credentials
NEBIUS_API_KEY=your_nebius_or_nvidia_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Models configuration
NEMOTRON_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Execution mode: 'cloud' (Nebius endpoint) or 'mock' (Deterministic local fallback)
EXECUTION_MODE=mock
SEED=42
